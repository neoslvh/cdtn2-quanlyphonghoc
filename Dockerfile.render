FROM node:24-alpine AS frontend-build
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
ARG VITE_API_MOCK=false
ENV VITE_API_MOCK=$VITE_API_MOCK
RUN npm run build

FROM node:24-alpine
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci
COPY backend ./
RUN npx prisma generate && mkdir -p /app/uploads
COPY --from=frontend-build /frontend/dist /app/public
ENV NODE_ENV=production
ENV CLIENT_DIST_DIR=/app/public
EXPOSE 10000
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma db seed && node src/server.js"]
