" page="1" pageScale="1" pageWidth="810" pageHeight="1865" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;5. Lập, sửa nháp, đính kèm và gửi yêu cầu (FR-07, FR-08, FR-09)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="750" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Đăng nhập sv01. Khi gửi, hệ thống kiểm tra lần lượt từ trên xuống, gặp điều kiện sai đầu tiên thì dừng và phiếu vẫn ở trạng thái Nháp." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="750" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Người đăng ký" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="1625" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="1625" as="geometry"/></mxCell><mxCell id="lane2" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="1625" as="geometry"/></mxCell><mxCell id="s" value="Tạo yêu cầu (hoặc từ Tra cứu phòng)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Điền đơn vị, phòng, mục đích, giờ, số người, thiết bị; bấm Lưu nháp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Đủ trường bắt buộc, đúng định dạng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="358" width="210" height="92" as="geometry"/></mxCell><mxCell id="o1" value="Lưu phiếu Nháp, có mã REQ-xxx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="295" y="474" width="220" height="70" as="geometry"/></mxCell><mxCell id="p2" value="Đính kèm tệp (tùy chọn); sửa nháp nếu cần (TC-FR09-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="582" width="220" height="66" as="geometry"/></mxCell><mxCell id="d2" value="PDF, Word hoặc ảnh thật, tối đa 5 MB, tối đa 5 tệp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="674" width="210" height="92" as="geometry"/></mxCell><mxCell id="p3" value="Bấm Gửi yêu cầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="792" width="220" height="66" as="geometry"/></mxCell><mxCell id="d3" value="1. Gửi trước ít nhất 3 ngày làm việc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="884" width="210" height="92" as="geometry"/></mxCell><mxCell id="d4" value="2. Kết thúc cùng ngày, không quá 21:30?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="988" width="210" height="92" as="geometry"/></mxCell><mxCell id="d5" value="3. Phòng đang Sẵn sàng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1094" width="210" height="92" as="geometry"/></mxCell><mxCell id="d6" value="4. Số người không vượt sức chứa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1198" width="210" height="92" as="geometry"/></mxCell><mxCell id="d7" value="5. Từ 200 người đã đính kèm văn bản Ban Giám hiệu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1304" width="210" height="92" as="geometry"/></mxCell><mxCell id="d8" value="6. Không trùng lớp học, lượt đặt đã duyệt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1408" width="210" height="92" as="geometry"/></mxCell><mxCell id="o2" value="Chuyển Đang duyệt, sinh bước duyệt: Phòng Đào tạo, Ban Giám hiệu (nếu từ 200 người), Phòng Quản trị cơ sở vật chất (TC-FR07-01, TC-FR12-01, TC-FR12-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="295" y="1524" width="220" height="70" as="geometry"/></mxCell><mxCell id="e" value="Phiếu Đang duyệt, không sửa được nữa (TC-FR09-02); sang trang 6" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1636" width="210" height="56" as="geometry"/></mxCell><mxCell id="x1" value="400: báo dưới từng ô (TC-FR07-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="364" width="220" height="80" as="geometry"/></mxCell><mxCell id="x2" value="413 Tệp vượt quá 5 MB / 415 Chỉ nhận PDF, Word hoặc ảnh / nội dung không đúng định dạng (TC-FR07-06, TC-FR07-09)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="680" width="220" height="80" as="geometry"/></mxCell><mxCell id="x3" value="422: Phải gửi yêu cầu trước giờ sử dụng ít nhất 3 ngày làm việc. (TC-FR07-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="890" width="220" height="80" as="geometry"/></mxCell><mxCell id="x4" value="422: Thời gian kết thúc không được muộn hơn 21:30 cùng ngày. (TC-FR07-07)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="994" width="220" height="80" as="geometry"/></mxCell><mxCell id="x5" value="409: Phòng X hiện không khả dụng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="1100" width="220" height="80" as="geometry"/></mxCell><mxCell id="x6" value="422: Số người tham dự vượt sức chứa của phòng X. (TC-FR07-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="1204" width="220" height="80" as="geometry"/></mxCell><mxCell id="x7" value="422: Hoạt động từ 200 người trở lên cần đính kèm văn bản của Ban Giám hiệu. (TC-FR07-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="1310" width="220" height="80" as="geometry"/></mxCell><mxCell id="x8" value="409: Phòng X đã có lớp học / lượt đặt được duyệt trong khung giờ này, nêu lớp hoặc mã phiếu (TC-FR08-01, TC-FR08-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="1414" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="p1"><mxGeometry relative=