ll id="e15" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d7" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="Có, bấm Đăng xuất" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d7" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Lần sai thứ 6 trong 15 phút bị chặn kể cả khi nhập đúng. Khóa tài khoản hoặc đổi vai trò có hiệu lực ngay ở thao tác kế tiếp, không cần đăng xuất. Đường dẫn chuyển về sau đăng nhập chỉ nhận đường dẫn trong hệ thống." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1440" width="750" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Tài khoản" id="p97633854"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;2. Cấp tài khoản, đổi vai trò, khóa, đổi mật khẩu (FR-01, FR-02)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Quản trị viên cấp tài khoản mới, người dùng đăng nhập bằng mật khẩu tạm và bắt buộc đổi mật khẩu." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1000" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Quản trị viên" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="lane1" value="Người dùng" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="lane2" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#f3f9ef;swimlaneFillColor=#f3f9ef;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="lane3" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="s" value="Mở trang Tài khoản" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="a1" value="Tìm theo tên hoặc email, lọc vai trò (TC-FR02-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="a2" value="Cấp tài khoản: họ tên, email, đơn vị, vai trò" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Email chưa có tài khoản, đơn vị hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="464" width="210" height="92" as="geometry"/></mxCell><mxCell id="o1" value="Mật khẩu tạm 12 ký tự hiện một lần (TC-FR02-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="45" y="580" width="220" height="70" as="geometry"/></mxCell><mxCell id="u1" value="Đăng nhập bằng mật khẩu tạm, bị đưa vào Đổi mật khẩu (TC-FR01-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="686" width="220" height="66" as="geometry"/></mxCell><mxCell id="u2" value="Nhập mật khẩu hiện tại, mật khẩu mới" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="792" width="220" height="66" as="geometry"/></mxCell><mxCell id="d2" value="Mật khẩu hiện tại đúng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="884" width="210" height="92" as="geometry"/></mxCell><mxCell id="d3" value="Mới từ 8 ký tự, có chữ và số, tối đa 72 byte, khác mật khẩu cũ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="988" width="210" height="92" as="geometry"/></mxCell><mxCell id="o2" value="Đổi xong, các phiên cũ bị thu hồi; dùng được toàn bộ chức năng (TC-FR01-07)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="295" y="1104" width="220" height="70" as="geometry"/></mxCell><mxCell id="a3" value="Đổi vai trò hoặc khóa một tài khoản" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="1212" width="220" height="66" as="geometry"/></mxCell><mxCell id="d4" value="Không phải tài khoản của chính mình?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="1198" width="210" height="92" as="geometry"/></mxCell><mxCell id="o3" value="Có hiệu lực ngay ở thao tác kế tiếp của người đó (TC-FR02-03, TC-FR01-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="545" y="1314" width="220" height="70" as="geometry"/></mxCell><mxCell id="x1" value="409: Email này đã có tài khoản. / 400: Đơn vị không hợp lệ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="x2" value="400: Mật khẩu hiện tại không đúng. Sai nhiều lần: 429" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="890" width="220" height="80" as="geometry"/></mxCell><mxCell id="x3" value="400: Mật khẩu từ 8 ký tự, ... gồm cả chữ và số. / Mật khẩu mới phải khác mật khẩu hiện tại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="994" width="220" height="80" as="geometry"/></mxCell><mxCell id="x4" value="409: Không thể tự đổi vai trò hoặc khóa tài khoản của chính mình." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="1204" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="a1"><mxGeometry relative="1" as="geometry"/></mxCe