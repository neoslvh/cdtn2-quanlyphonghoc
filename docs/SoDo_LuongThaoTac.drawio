ry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="u3" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u3" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="u3" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b1" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b2" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b3" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Người duyệt không có trang chi tiết phiếu nên không có nút Xem yêu cầu, chỉ đánh dấu đã đọc. Thử thêm: đăng nhập daotao không thấy thông báo của sv01." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="915" width="1000" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="9. Lịch học chính khóa" id="p97969722"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="1445" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;9. Nhập thời khóa biểu, xác nhận, sửa và hủy buổi học (FR-23, BR-10 đến BR-12)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1250" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Đăng nhập daotao (Phòng Đào tạo) hoặc admin; vai trò khác không thấy menu và API trả 403 (TC-FR23-06)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1250" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Phòng Đào tạo" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="500" height="1205" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="1205" as="geometry"/></mxCell><mxCell id="lane2" value="Người đăng ký" style="swimlane;startSize=32;html=1;fillColor=#f3f9ef;swimlaneFillColor=#f3f9ef;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="250" height="1205" as="geometry"/></mxCell><mxCell id="lane3" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="250" height="1205" as="geometry"/></mxCell><mxCell id="s" value="Mở Lịch học chính khóa" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Tải tệp mẫu (TC-FR23-01), điền lớp, thứ, tiết, phòng, từ ngày, đến ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="p2" value="Chọn học kỳ, chế độ Thêm mới hoặc Thay thế, tải tệp CSV/XLSX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Tệp đúng cột, ngày, tiết, phòng; không trùng trong tệp; không trùng lớp đang hiệu lực?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="464" width="210" height="92" as="geometry"/></mxCell><mxCell id="o1" value="Bản xem trước: số buổi, các phiếu sẽ bị hủy vì trùng (TC-FR23-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="45" y="580" width="220" height="70" as="geometry"/></mxCell><mxCell id="p3" value="Xác nhận hay hủy bản xem trước?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="674" width="210" height="92" as="geometry"/></mxCell><mxCell id="c1" value="Hủy bản xem trước, không đổi lịch; ghi nhật ký" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="796" width="210" height="56" as="geometry"/></mxCell><mxCell id="d2" value="Bản nhập còn ở xem trước, không trùng lớp vừa kích hoạt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="778" width="210" height="92" as="geometry"/></mxCell><mxCell id="o2" value="Kích hoạt buổi học; Thay thế thì hủy lịch cũ cùng học kỳ; hủy phiếu trùng, bước duyệt, lượt đặt (TC-FR23-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="545" y="894" width="220" height="70" as="geometry"/></mxCell><mxCell id="o3" value="Thông báo bị hủy, nêu lớp gây trùng (TC-FR14-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="795" y="1000" width="220" height="70" as="geometry"/></mxCell><mxCell id="p4" value="Sửa giờ, phòng hoặc hủy từng buổi học (TC-FR23-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="1106" width="220" height="66" as="geometry"/></mxCell><mxCell id="d3" value="Buổi đang hiệu lực, giờ hợp lệ, phòng không trùng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="1094" width="210" height="92" as="geometry"/></mxCell><mxCell id="o4" value="Lưu, ghi nhật ký giá trị trước và sau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="545" y="1210" width="220" height="70" as="geometry"/></mxCell><mxCell id="x1" value="422 IMPORT_INVALID: lỗi theo từng dòng, từng cột, không lưu dòng nào (TC-FR23-02, TC-FR23-08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="x2" value="409 Lần nhập không còn ở trạng thái xem trước / Lớp X trùng giờ với lớp Y đang có hiệu lực. Xác nhận đồng thời chỉ một thành công (TC-FR23-07)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="784" width="220" height="80" as="geometry"/></mxCell><mxCell id="x3" value="409: Phòng X đã có lớp học hoặc lượt đặt trong khung giờ này. / Chỉ sửa được buổi học đang hiệu lực." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="1100" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o1" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Hủy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Xác nhận" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Thay thế cùng học kỳ không tính các lớp sắp bị thay khi kiểm tra trùng. Lớp ở trạng thái xem trước chưa chặn phòng; chỉ lớp đã xác nhận mới chặn tra cứu và gửi yêu cầu." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1335" width="1250" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="10. Check-in và báo hỏng" id="p46585958"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="1655" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;10. Check-in bằng QR và báo hỏng thiết bị (FR-18, FR-19)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1250" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Đăng nhập sv01, mở một phiếu Đã duyệt, mục Sử dụng phòng. Cả hai chỉ làm được trong giờ dùng phòng: từ 15 phút trước giờ bắt đầu đến giờ kết thúc. Bàn giao, nhận trả (SCRUM-22) và phiếu bảo trì (SCRUM-25) chờ API." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1250" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Người đăng ký" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="500" height="1415" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="1415" as="geometry"/></mxCell><mxCell id="lane2" value="Nhân viên cơ sở vật chất" style="swimlane;startSize=32;html=1;fillColor=#f3f9ef;swimlaneFillColor=#f3f9ef;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="250" height="1415" as="geometry"/></mxCell><mxCell id="lane3" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="250" height="1415" as="geometry"/></mxCell><mxCell id="s" value="Mở phiếu Đã duyệt" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="u0" value="Check-in hay báo hỏng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="254" width="210" height="92" as="geometry"/></mxCell><mxCell id="u1" value="Bấm Quét QR tại cửa phòng hoặc nhập mã in dưới hình QR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="c1" value="Phiếu của mình, Đã duyệt, chưa check-in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="464" width="210" height="92" as="geometry"/></mxCell><mxCell id="c2" value="Mã QR đúng phòng của phiếu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="568" width="210" height="92" as="geometry"/></mxCell><mxCell id="c3" value="Trong giờ dùng phòng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="674" width="210" height="92" as="geometry"/></mxCell><mxCell id="o1" value='"Đã check-in lúc ..."; ô nhập mã ẩn đi (TC-FR18-01)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="45" y="790" width="220" height="70" as="geometry"/></mxCell><mxCell id="u2" value="Bấm Báo hỏng thiết bị, chọn thiết bị của phòng, nhập mô tả, chọn ảnh (tùy chọn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="896" width="220" height="66" as="geometry"/></mxCell><mxCell id="i1" value="Đã chọn thiết bị, có mô tả; ảnh PNG hoặc JPG thật, tối đa 5 MB?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="988" width="210" height="92" as="geometry"/></mxCell><mxCell id="i2" value="Trong giờ dùng phòng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="1094" width="210" height="92" as="geometry"/></mxCell><mxCell id="i3" value="Thiết bị thuộc phòng và đang Tốt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="1198" width="210" height="92" as="geometry"/></mxCell><mxCell id="o2" value="Tạo báo hỏng Mới báo, thiết bị chuyển Hỏng (TC-FR19-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="545" y="1314" width="220" height="70" as="geometry"/></mxCell><mxCell id="o3" value="Thấy ở Bàn giao và báo hỏng, tab Báo hỏng: thời gian, phòng, thiết bị, mô tả, người báo, mã phiếu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="795" y="1420" width="220" height="70" as="geometry"/></mxCell><mxCell id="x1" value="409: Chỉ check-in được yêu cầu đã duyệt. / Yêu cầu này đã check-in." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="x2" value="409: Mã QR không phải của phòng X. (TC-FR18-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="574" width="220" height="80" as="geometry"/></mxCell><mxCell id="x3" value="409: Chỉ check-in được từ HH:mm dd/mm/yyyy đến HH:mm dd/mm/yyyy. (TC-FR18-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="680" width="220" height="80" as="geometry"/></mxCell><mxCell id="x4" value='Form báo "Chọn thiết bị bị hỏng" / "Mô tả tình trạng hỏng" (TC-FR19-01); ảnh sai: 415, quá 5 MB: 413' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="994" width="220" height="80" as="geometry"/></mxCell><mxCell id="x5" value="409: Chỉ báo hỏng được trong thời gian sử dụng phòng, từ ... đến ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="1100" width="220" height="80" as="geometry"/></mxCell><mxCell id="x6" value="409: Thiết bị X đã được báo hỏng và đang chờ xử lý. / Thiết bị X đang bảo trì. / 400: Thiết bị không thuộc phòng X." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="1204" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="u0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Check-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u0" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Báo hỏng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="u0" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Xác nhận check-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="u1" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Gửi báo hỏng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="u2" target="i1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i1" target="x4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i2" target="x5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="i3" target="x6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="i3" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Phiếu thật phải gửi trước 3 ngày làm việc nên muốn thử ca thành công cần dời giờ phiếu đã duyệt về hiện tại trong cơ sở dữ liệu kiểm thử (bộ E2E-15 làm việc này khi đặt E2E_PSQL), rồi trả thiết bị về Tốt sau khi thử. Mã QR quét được có dạng đường dẫn .../qr/{mã}; nhập cả đường dẫn hay chỉ mã đều được." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1545" width="1250" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="11. Nhật ký thao tác" id="p16665318"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="810" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;11. Nhật ký thao tác (FR-21, NFR-07)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="750" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Đăng nhập admin. Ghi lại: tạo, sửa, gửi, hủy, duyệt, từ chối, hết hạn, hủy do lịch học, check-in, báo hỏng, thêm sửa phòng, nhập và sửa thời khóa biểu." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="750" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Quản trị viên" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="680" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="680" as="geometry"/></mxCell><mxCell id="lane2" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="680" as="geometry"/></mxCell><mxCell id="s" value="Mở Nhật ký thao tác" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Lọc theo hành động, người thực hiện, mã đối tượng (mã phiếu dạng UUID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Mã đối tượng đúng định dạng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="358" width="210" height="92" as="geometry"/></mxCell><mxCell id="d2" value="Người gọi là quản trị viên?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="464" width="210" height="92" as="geometry"/></mxCell><mxCell id="o1" value="Danh sách mới nhất trước; mở rộng dòng thấy giá trị trước, sau và lý do (TC-FR21-01, TC-FR21-02, TC-FR21-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="45" y="580" width="220" height="70" as="geometry"/></mxCell><mxCell id="e" value="Mỗi thao tác duyệt, sửa, hủy đều có đúng một dòng (TC-NFR07-01)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="692" width="210" height="56" as="geometry"/></mxCell><mxCell id="x1" value="Báo lỗi ngay dưới ô nhập, không gọi máy chủ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="364" width="220" height="80" as="geometry"/></mxCell><mxCell id="x2" value="Vai trò khác không thấy menu; API trả 403 (TC-FR21-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o1" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Mã đối tượng không có bản ghi thì bảng rỗng, không báo lỗi. Thao tác do hệ thống tự làm (hết hạn) có người thực hiện để trống." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="810" width="750" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="12. Trạng thái phiếu" id="p70363932"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="710" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;12. Vòng đời trạng thái của phiếu đề xuất&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1250" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Dùng để thử đủ các đường chuyển trạng thái và kiểm tra thao tác bị chặn ở từng trạng thái." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1250" height="48" as="geometry"/></mxCell><mxCell id="s" value="Tạo yêu cầu" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="draft" value="Nháp (DRAFT)&lt;br&gt;sửa, đính kèm, hủy" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="170" height="60" as="geometry"/></mxCell><mxCell id="pend" value="Đang duyệt (PENDING)&lt;br&gt;hủy được" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="570" y="270" width="170" height="60" as="geometry"/></mxCell><mxCell id="appr" value="Đã duyệt (APPROVED)&lt;br&gt;in phiếu, check-in, báo hỏng" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="164" width="170" height="60" as="geometry"/></mxCell><mxCell id="rej" value="Từ chối (REJECTED)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="270" width="170" height="60" as="geometry"/></mxCell><mxCell id="exp" value="Hết hạn (EXPIRED)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="374" width="170" height="60" as="geometry"/></mxCell><mxCell id="can" value="Đã hủy (CANCELLED)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="570" y="480" width="170" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="draft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Gửi, qua 6 bước kiểm tra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="draft" target="pend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Cấp cuối đồng ý" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="pend" target="appr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Một cấp từ chối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pend" target="rej"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Tới giờ bắt đầu chưa duyệt xong" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="pend" target="exp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Người đăng ký hủy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="draft" target="can"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Người đăng ký hủy; lịch học mới trùng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pend" target="can"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Lịch học mới trùng (BR-11)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="appr" target="can"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Cấp duyệt giữa đồng ý thì phiếu vẫn Đang duyệt, chỉ chuyển sang bước kế tiếp. Từ chối, Hết hạn, Đã hủy là trạng thái cuối: không sửa, không gửi lại, không hủy được; muốn dùng phòng thì tạo phiếu mới." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="1250" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>