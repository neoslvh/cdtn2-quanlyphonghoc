="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d4" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d4" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Chuỗi duyệt hiện cố định trong mã: Phòng Đào tạo, thêm Ban Giám hiệu khi từ 200 người, cuối cùng Phòng Quản trị cơ sở vật chất. Người đăng ký theo dõi ở Yêu cầu của tôi: trạng thái và cấp đang xử lý cập nhật sau mỗi quyết định (TC-FR10-01, TC-FR10-02). Mọi quyết định ghi nhật ký (TC-FR21-01)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1440" width="1250" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7. Theo dõi và hủy" id="p18316464"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="810" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;7. Theo dõi và hủy yêu cầu (FR-09, FR-10)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="750" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Đăng nhập sv01. Chỉ hủy được phiếu Nháp hoặc Đang duyệt của chính mình." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="750" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Người đăng ký" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="680" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="680" as="geometry"/></mxCell><mxCell id="lane2" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="680" as="geometry"/></mxCell><mxCell id="s" value="Mở Yêu cầu của tôi" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Lọc theo trạng thái (TC-FR10-03); xem trạng thái và đơn vị đang xử lý (TC-FR10-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="p2" value="Mở phiếu, bấm Hủy yêu cầu, nhập lý do (không bắt buộc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Phiếu của mình, đang Nháp hoặc Đang duyệt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="464" width="210" height="92" as="geometry"/></mxCell><mxCell id="o1" value="Phiếu Đã hủy, bước chờ Đã hủy, hiện lý do hủy; ghi nhật ký (TC-FR09-03, TC-FR21-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="295" y="580" width="220" height="70" as="geometry"/></mxCell><mxCell id="e" value="Phiếu không còn trong hàng chờ của người duyệt" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="692" width="210" height="56" as="geometry"/></mxCell><mxCell id="x1" value="409: Yêu cầu không còn hủy được. Phiếu đã duyệt, từ chối, hết hạn không có nút Hủy; phiếu người khác báo 404" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="p2"><mxGeomet