g băm bcrypt, không lưu bản rõ (TC-NFR04-02). Mọi tài khoản đổi mật khẩu ở menu Đổi mật khẩu theo cùng luồng từ bước "Nhập mật khẩu hiện tại".' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1440" width="1000" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Phòng và mã QR" id="p98848997"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;3. Quản lý phòng và mã QR (FR-03, FR-05)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Đăng nhập csvc hoặc admin. Phần quản lý thiết bị chờ API SCRUM-9 (TC-FR04-01, TC-FR04-02 Blocked)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1000" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Nhân viên cơ sở vật chất" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="lane2" value="Người dùng quét mã" style="swimlane;startSize=32;html=1;fillColor=#f3f9ef;swimlaneFillColor=#f3f9ef;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="lane3" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="s" value="Mở Quản lý phòng" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Tìm theo mã, tên; lọc cơ sở, tòa, loại, trạng thái, sức chứa (TC-FR03-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="p2" value="Thêm phòng: mã, tên, cơ sở, loại, sức chứa, trạng thái" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Mã phòng chưa có, tòa thuộc đúng cơ sở?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="464" width="210" height="92" as="geometry"/></mxCell><mxCell id="o1" value="Phòng mới trong danh sách, ghi nhật ký ROOM_CREATED (TC-FR03-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="45" y="580" width="220" height="70" as="geometry"/></mxCell><mxCell id="p3" value="Sửa phòng: không đổi được mã, cơ sở (TC-FR03-05); đặt Bảo trì hoặc Ngừng sử dụng (TC-FR03-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="686" width="220" height="66" as="geometry"/></mxCell><mxCell id="p4" value="Bấm QR ở dòng phòng, xem và In mã QR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="792" width="220" height="66" as="geometry"/></mxCell><mxCell id="o2" value="Ảnh QR chứa đường dẫn /qr/{mã}, dưới hình in mã phòng và mã token; mỗi phòng một mã riêng (TC-FR05-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="295" y="894" width="220" height="70" as="geometry"/></mxCell><mxCell id="u1" value="Quét QR bằng camera điện thoại, mở đường dẫn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="545" y="1002" width="220" height="66" as="geometry"/></mxCell><mxCell id="d2" value="Đã đăng nhập?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1094" width="210" height="92" as="geometry"/></mxCell><mxCell id="u2" value="Đăng nhập, quay lại đúng trang mã QR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="545" y="1106" width="220" height="66" as="geometry"/></mxCell><mxCell id="d3" value="Mã QR có trong hệ thống?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1198" width="210" height="92" as="geometry"/></mxCell><mxCell id="o3" value="Trang thông tin phòng hoặc thiết bị, trạng thái hiện tại kể cả khi Bảo trì, Hỏng (TC-FR05-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="545" y="1314" width="220" height="70" as="geometry"/></mxCell><mxCell id="x1" value="400: Mã phòng đã tồn tại. / Tòa X thuộc cơ sở Y. (TC-FR03-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="x3" value='Trang báo "Mã QR không hợp lệ"' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="1204" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o1" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Dán tại cửa phòng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="o2" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="u1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="u2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Phòng Bảo trì hoặc Ngừng sử dụng không còn trong tra cứu phòng trống và không gửi yêu cầu được (409 ROOM_UNAVAILABLE). Mã QR thiết bị in từ trang Thiết bị khi có API SCRUM-9; xem thử bằng đường dẫn /qr/{qrToken} của thiết bị." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1440" width="1000" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Tra cứu phòng" id="p23413241"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="810" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;4. Tra cứu phòng trống (FR-06)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="750" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Đăng nhập sv01. Phòng trống là phòng Sẵn sàng, đủ sức chứa, đủ thiết bị Tốt và không có buổi học hay lượt đặt đã duyệt giao với khung giờ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="750" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Người đăng ký" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="890" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="890" as="geometry"/></mxCell><mxCell id="lane2" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="890" as="geometry"/></mxCell><mxCell id="s" value="Mở Tra cứu phòng" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Chọn ngày, giờ bắt đầu, giờ kết thúc, số người; lọc cơ sở, loại phòng, thiết bị" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Kết thúc sau bắt đầu, cùng ngày, không quá 21:30; số người nguyên dương?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="358" width="210" height="92" as="geometry"/></mxCell><mxCell id="p2" value="Bỏ phòng không Sẵn sàng, thiếu sức chứa, thiếu thiết bị Tốt (TC-FR06-02, TC-FR06-03, TC-FR04-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="476" width="220" height="66" as="geometry"/></mxCell><mxCell id="p3" value="Bỏ phòng có buổi học ACTIVE hoặc lượt đặt đã duyệt giao khung giờ; chạm đầu mút không tính (TC-FR06-04, TC-FR06-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="582" width="220" height="66" as="geometry"/></mxCell><mxCell id="o1" value="Danh sách phòng trống trong 3 giây (TC-FR06-01, TC-NFR03-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="45" y="684" width="220" height="70" as="geometry"/></mxCell><mxCell id="p4" value="Bấm Đặt phòng này" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="792" width="220" height="66" as="geometry"/></mxCell><mxCell id="e" value="Phiếu mới điền sẵn phòng, giờ, số người, thiết bị (TC-FR07-08), sang trang 5" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="902" width="210" height="56" as="geometry"/></mxCell><mxCell id="x1" value='400: báo dưới ô nhập, ví dụ "Giờ kết thúc không muộn hơn 21:30." (TC-FR06-05)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="364" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Bấm Tìm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" 