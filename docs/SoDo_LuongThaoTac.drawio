<mxfile host="drawio" agent="CDTN2" version="24.0.0"><diagram name="0. Tổng quan" id="p47209503"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="1025" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Tổng quan chức năng theo vai trò&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1250" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Mỗi trang sau là luồng thao tác của một nhóm chức năng. Ô vàng là điểm hệ thống kiểm tra, ô đỏ là thông báo lỗi hệ thống trả về, ô xanh lá là kết quả đúng. Mã trong ngoặc là test case trong TestCase_QuanLyPhongHoc_ThietBi_v2.xlsx." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1250" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Người đăng ký (sv01)" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="785" as="geometry"/></mxCell><mxCell id="lane1" value="Người duyệt (daotao: Phòng Đào tạo)" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="785" as="geometry"/></mxCell><mxCell id="lane2" value="Nhân viên cơ sở vật chất (csvc)" style="swimlane;startSize=32;html=1;fillColor=#f3f9ef;swimlaneFillColor=#f3f9ef;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="785" as="geometry"/></mxCell><mxCell id="lane3" value="Quản trị viên (admin)" style="swimlane;startSize=32;html=1;fillColor=#fdf6ec;swimlaneFillColor=#fdf6ec;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="250" height="785" as="geometry"/></mxCell><mxCell id="lane4" value="Chú thích" style="swimlane;startSize=32;html=1;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="250" height="785" as="geometry"/></mxCell><mxCell id="a0" value="Đăng nhập, đổi mật khẩu&lt;br&gt;(trang 1, 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="162" width="220" height="66" as="geometry"/></mxCell><mxCell id="a1" value="Tra cứu phòng trống&lt;br&gt;(trang 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="a2" value="Lập, sửa nháp, đính kèm, gửi yêu cầu&lt;br&gt;(trang 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="a3" value="Theo dõi, hủy yêu cầu&lt;br&gt;(trang 7, 12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="476" width="220" height="66" as="geometry"/></mxCell><mxCell id="a4" value="Thông báo&lt;br&gt;(trang 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="582" width="220" height="66" as="geometry"/></mxCell><mxCell id="a5" value="Check-in bằng QR, báo hỏng thiết bị&lt;br&gt;(trang 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="686" width="220" height="66" as="geometry"/></mxCell><mxCell id="a6" value="In phiếu / lưu PDF khi đã duyệt&lt;br&gt;(trang 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="792" width="220" height="66" as="geometry"/></mxCell><mxCell id="b0" value="Duyệt hoặc từ chối phiếu của đơn vị mình&lt;br&gt;(trang 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="162" width="220" height="66" as="geometry"/></mxCell><mxCell id="b1" value="Phòng Đào tạo: nhập thời khóa biểu, sửa, hủy buổi học&lt;br&gt;(trang 9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="b2" value="Thông báo&lt;br&gt;(trang 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="c0" value="Quản lý phòng, in mã QR phòng&lt;br&gt;(trang 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="545" y="162" width="220" height="66" as="geometry"/></mxCell><mxCell id="c1" value="Xem danh sách báo hỏng&lt;br&gt;(trang 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="545" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="c2" value="Duyệt cấp cuối (tài khoản duyệt của Phòng Quản trị cơ sở vật chất)&lt;br&gt;(trang 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="545" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="c3" value="Chờ API: quản lý thiết bị (SCRUM-9), bàn giao (SCRUM-22), bảo trì (SCRUM-25), lịch phòng (SCRUM-16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="d0" value="Cấp, khóa tài khoản, đổi vai trò&lt;br&gt;(trang 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="795" y="162" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Nhật ký thao tác&lt;br&gt;(trang 11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="795" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="d2" value="Xem mọi yêu cầu, quản lý phòng, nhập thời khóa biểu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="795" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="d3" value="Chờ API: quy tắc duyệt (SCRUM-21), báo cáo thống kê (SCRUM-27)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="l0" value="Bắt đầu" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="l1" value="Thao tác của người dùng hoặc xử lý của hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1045" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="l2" value="Điều kiện hệ thống kiểm tra" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="358" width="210" height="92" as="geometry"/></mxCell><mxCell id="l3" value="Lỗi: mã HTTP và thông báo hiện trên giao diện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="l4" value="Kết quả đúng cần thấy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1045" y="580" width="220" height="70" as="geometry"/></mxCell><mxCell id="l5" value="Kết thúc" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1050" y="692" width="210" height="56" as="geometry"/></mxCell><mxCell id="note" value='Tài khoản mẫu do seed tạo: sv01@qlphong.local (người đăng ký), daotao@qlphong.local (người duyệt Phòng Đào tạo), csvc@qlphong.local (nhân viên cơ sở vật chất), admin@qlphong.local (quản trị viên); mật khẩu theo SEED_PASSWORD trong docker-compose.yml. Tài khoản duyệt của Phòng Quản trị cơ sở vật chất và Ban Giám hiệu do quản trị viên cấp ở trang Tài khoản. Các chức năng chờ API vẫn mở được giao diện và báo "chưa có API ở máy chủ" (TC-UI-04).' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="915" width="1250" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="1. Đăng nhập" id="p78664031"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="810" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;1. Đăng nhập, phiên làm việc, đăng xuất (FR-01, FR-02)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="750" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Thử với từng vai trò ở trang 0. Kiểm tra theo thứ tự các ô vàng: mỗi điều kiện sai phải ra đúng thông báo ở cột lỗi." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="750" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Người dùng" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="lane2" value="Kết quả lỗi" style="swimlane;startSize=32;html=1;fillColor=#fdf0f0;swimlaneFillColor=#fdf0f0;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="250" height="1310" as="geometry"/></mxCell><mxCell id="s" value="Mở trang /login" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Nhập email, mật khẩu, bấm Đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="d1" value="Đủ email và mật khẩu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="358" width="210" height="92" as="geometry"/></mxCell><mxCell id="d2" value="Sai dưới 5 lần trong 15 phút?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="464" width="210" height="92" as="geometry"/></mxCell><mxCell id="d3" value="Email và mật khẩu đúng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="568" width="210" height="92" as="geometry"/></mxCell><mxCell id="d4" value="Tài khoản đang hoạt động?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="674" width="210" height="92" as="geometry"/></mxCell><mxCell id="d5" value="Phải đổi mật khẩu lần đầu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="778" width="210" height="92" as="geometry"/></mxCell><mxCell id="p2" value="Chỉ vào được trang Đổi mật khẩu (trang 2) (TC-FR01-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="792" width="220" height="66" as="geometry"/></mxCell><mxCell id="o1" value="Vào trang đang mở dở hoặc Trang chủ, menu đúng vai trò (TC-FR01-01, TC-FR02-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="295" y="894" width="220" height="70" as="geometry"/></mxCell><mxCell id="p3" value="Dùng hệ thống; gọi chức năng trái vai trò" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="1002" width="220" height="66" as="geometry"/></mxCell><mxCell id="d6" value="Đúng vai trò?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="988" width="210" height="92" as="geometry"/></mxCell><mxCell id="d7" value="Phiên còn hiệu lực? (hết hạn, bị khóa, đổi mật khẩu ở nơi khác)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1094" width="210" height="92" as="geometry"/></mxCell><mxCell id="o2" value="Về /login báo phiên hết hạn; đăng nhập lại quay về đúng trang cũ (TC-FR01-08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="45" y="1210" width="220" height="70" as="geometry"/></mxCell><mxCell id="e" value="Đăng xuất: vào lại trang cần đăng nhập thì về /login (TC-FR01-03)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1322" width="210" height="56" as="geometry"/></mxCell><mxCell id="x1" value="400: Vui lòng nhập email và mật khẩu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="364" width="220" height="80" as="geometry"/></mxCell><mxCell id="x2" value="429: Đăng nhập sai quá nhiều lần, vui lòng thử lại sau 15 phút. (TC-FR01-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="470" width="220" height="80" as="geometry"/></mxCell><mxCell id="x3" value="401: Email hoặc mật khẩu không đúng. (TC-FR01-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="574" width="220" height="80" as="geometry"/></mxCell><mxCell id="x4" value="403: Tài khoản đang chờ quản trị viên duyệt / Tài khoản đã bị khóa. (TC-FR01-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="680" width="220" height="80" as="geometry"/></mxCell><mxCell id="x6" value="Giao diện chuyển về Trang chủ; API trả 403 (TC-FR02-02, TC-NFR04-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="994" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" tar