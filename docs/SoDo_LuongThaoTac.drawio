="34" as="geometry"/></mxCell><mxCell id="sub" value="Thông báo là của riêng từng người (TC-FR14-05). Số chưa đọc trên thanh trên tự tải lại mỗi 30 giây và cập nhật ngay sau mỗi thao tác." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1000" height="48" as="geometry"/></mxCell><mxCell id="lane0" value="Hệ thống" style="swimlane;startSize=32;html=1;fillColor=#f5f5f5;swimlaneFillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="785" as="geometry"/></mxCell><mxCell id="lane1" value="Người dùng" style="swimlane;startSize=32;html=1;fillColor=#eef3fb;swimlaneFillColor=#eef3fb;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="750" height="785" as="geometry"/></mxCell><mxCell id="s" value="Sự kiện: duyệt xong, từ chối, bị hủy do lịch học, hết hạn" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Tạo thông báo cho người đăng ký của phiếu (TC-FR14-01, TC-FR14-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="266" width="220" height="66" as="geometry"/></mxCell><mxCell id="u1" value='Thanh trên hiện "Thông báo" kèm số chưa đọc (TC-FR14-03)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="372" width="220" height="66" as="geometry"/></mxCell><mxCell id="u2" value="Mở trang Thông báo, lọc Tất cả / Chưa đọc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="295" y="476" width="220" height="66" as="geometry"/></mxCell><mxCell id="u3" value="Thao tác" style="rho