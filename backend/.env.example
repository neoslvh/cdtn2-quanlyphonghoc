PORT=3000
# Khóa ký JWT, tối thiểu 16 ký tự. Tạo khóa riêng cho mỗi môi trường, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-truoc-khi-chay
# Mật khẩu của các tài khoản mẫu do npm run db:seed tạo (admin@qlphong.local, csvc@qlphong.local, daotao@qlphong.local)
SEED_PASSWORD=Demo@12345
# Địa chỉ giao diện ghi vào mã QR phòng và thiết bị (FR-05), ví dụ https://qlphong.example.edu.vn.
# Bắt buộc khi NODE_ENV=production (trên Render dùng RENDER_EXTERNAL_URL nếu không đặt).
# Bỏ trống chỉ dùng khi chạy thử: mã QR lấy địa chỉ đang mở trang.
APP_URL=
